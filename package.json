{
  "name": "@huangxm168/ip-geo",
  "version": "0.3.0",
  "description": "IP 地区解析：中国境内用 ip2region，海外与港澳台用 MaxMind GeoLite 补齐城市与运营商 / IP geolocation combining ip2region (China) and MaxMind GeoLite (rest of the world)",
  "keywords": [
    "ip",
    "geolocation",
    "ip2region",
    "maxmind",
    "geolite2",
    "mmdb"
  ],
  "license": "MIT",
  "author": "Sherman Huang",
  "homepage": "https://github.com/huangxm168/ip-geo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangxm168/ip-geo.git"
  },
  "bugs": {
    "url": "https://github.com/huangxm168/ip-geo/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ip-geo": "./dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "ops",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:workflows": "bash scripts/lint-workflows.sh",
    "format": "prettier --write .",
    "fetch:test-data": "tsx src/cli.ts ip2region fetch --dir test/.data/ip2region",
    "pretest": "npm run fetch:test-data",
    "test": "vitest run",
    "check:pack": "npm run build && publint && npm pack --dry-run",
    "ip2region:update": "tsx scripts/update-ip2region.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ip2region.js": "^3.1.8",
    "maxmind": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
