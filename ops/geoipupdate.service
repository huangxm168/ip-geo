# 更新 MaxMind GeoLite 数据库（由 geoipupdate.timer 触发）
# 安装与说明见 docs/operations.md
[Unit]
Description=更新 MaxMind GeoLite 数据库（ip-geo）
Documentation=https://github.com/huangxm168/ip-geo/blob/main/docs/operations.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# 先比对哈希，没有新版本时不下载、不计额度；有新版本时写临时文件再改名，网站那边按修改时间自动换上
ExecStart=/usr/bin/geoipupdate -v
# 刻意不设 Restart：免费账户每 24 小时只有 30 次下载，失败就等下一次定时，不在这里循环重试
ProtectSystem=strict
ReadWritePaths=/var/lib/GeoIP
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
